{
  "name": "Miao Library Android",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/android-sdk:1": {
      "platforms": "android-34",
      "buildTools": "34.0.0",
      "platformTools": true,
      "accept_license": true
    }
  },
  "containerEnv": {
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk",
    "GRADLE_USER_HOME": "/workspaces/.gradle"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-gradle",
        "fwcd.kotlin"
      ]
    }
  },
  "postCreateCommand": "chmod +x ./gradlew && yes | sdkmanager --licenses >/dev/null 2>&1 || true"
}
