{
  "name": "Miao Library Android",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/android-sdk:1": {
      "platforms": "android-34",
      "buildTools": "34.0.0",
      "accept_license": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-gradle",
        "fwcd.kotlin"
      ]
    }
  },
  "postCreateCommand": "yes | sdkmanager --licenses >/dev/null 2>&1 || true"
}
